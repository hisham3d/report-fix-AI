# ---- AI provider (any OpenAI-compatible /chat/completions endpoint) ----
# Leave AI_API_KEY empty to run in clearly-labelled fallback mode.
AI_API_KEY=your_api_key_here
AI_MODEL=your_supported_model_here
AI_BASE_URL=https://api.openai.com/v1
# Optional: embeddings model on the same provider for semantic duplicate similarity
AI_EMBED_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2

# ---- Campus ----
CAMPUS_NAME=your_college_name
# Optional official public website used only by Admin > Locations > discovery
CAMPUS_WEBSITE=
CAMPUS_UTC_OFFSET_HOURS=5

# ---- Judge Mode (local demo only; defaults to false when unset) ----
JUDGE_MODE=true

# Optional custom database path
# REPORTFIX_DB=data/reportfix.db
